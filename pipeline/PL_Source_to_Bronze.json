{
	"name": "PL_Source_to_Bronze",
	"properties": {
		"activities": [
			{
				"name": "ForEach_folder",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.p_folder_list",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy_Source_To_Bronze",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"modifiedDatetimeStart": {
											"value": "@pipeline().parameters.p_start_time",
											"type": "Expression"
										},
										"modifiedDatetimeEnd": {
											"value": "@pipeline().parameters.p_end_time",
											"type": "Expression"
										},
										"wildcardFolderPath": {
											"value": "@item()",
											"type": "Expression"
										},
										"wildcardFileName": "*",
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"copyBehavior": "MergeFiles"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_Source_CSV",
									"type": "DatasetReference",
									"parameters": {
										"p_container": "@pipeline().parameters.p_source_container",
										"p_directory": "@item()",
										"p_file_name": "*"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Bronze_CSV",
									"type": "DatasetReference",
									"parameters": {
										"p_container": "@pipeline().parameters.p_bronze_container",
										"p_directory": "@concat(pipeline().parameters.p_project_name,'/',item())",
										"p_file_name": "@concat(item(),'.csv')"
									}
								}
							]
						},
						{
							"name": "Get Metadata1",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_Source_CSV",
									"type": "DatasetReference",
									"parameters": {
										"p_container": "@pipeline().parameters.p_source_container",
										"p_directory": "@item()",
										"p_file_name": "*"
									}
								},
								"fieldList": [
									"childItems"
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							}
						},
						{
							"name": "Filter1",
							"type": "Filter",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"items": {
									"value": "@activity('Get_Files').output.childItems",
									"type": "Expression"
								},
								"condition": {
									"value": "@equals(item().type,'File')",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_source_container": {
				"type": "string",
				"defaultValue": "sales-view-devtst"
			},
			"p_bronze_container": {
				"type": "string",
				"defaultValue": "bronze"
			},
			"p_project_name": {
				"type": "string",
				"defaultValue": "sales-view"
			},
			"p_folder_list": {
				"type": "array",
				"defaultValue": [
					"customer",
					"product",
					"store",
					"sales"
				]
			},
			"p_start_time": {
				"type": "string",
				"defaultValue": "2026-04-24T00:00:00Z"
			},
			"p_end_time": {
				"type": "string",
				"defaultValue": "2026-04-25T00:00:00Z"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-04-24T13:29:03Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}